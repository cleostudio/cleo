# Cleo agent (OpenAI Responses API). Required for /cleo and /api/responses.
OPENAI_API_KEY=

# Optional. Public discovery identity for canonical links, feeds, and social
# metadata. Defaults to the alpha deploy, and previews stub it during prebuild;
# set it only when serving a custom domain.
# PUBLIC_SITE_URL=https://cleoalpha.vercel.app
# SITE_URL=https://cleoalpha.vercel.app

# Neon Postgres (Vercel Marketplace). Required for Better Auth.
# Prefer DATABASE_URL from `vercel integration add neon` + `vercel env pull`.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Legacy Marketplace aliases also work:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Better Auth (self-hosted library — not a Marketplace product).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_SECRET=
# Optional explicit origin; otherwise PUBLIC_SITE_URL / SITE_URL / VERCEL_URL / localhost.
# BETTER_AUTH_URL=http://localhost:3000
