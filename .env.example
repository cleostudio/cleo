# Public discovery identity for canonical links, feeds, and social metadata.
# Defaults to the alpha deploy when unset; override for a custom domain.
PUBLIC_SITE_URL=https://cleoalpha.vercel.app
# Operational origin for links and browser mutations.
SITE_URL=https://cleoalpha.vercel.app

# Cleo agent (OpenAI Responses API). Required for /cleo and /api/responses.
OPENAI_API_KEY=

# Abuse and cost controls for POST /api/responses. All optional; the defaults
# below apply when unset, and each one can be retuned without a code change.
# Requests allowed per client inside the burst window.
CLEO_RATE_LIMIT_BURST=5
CLEO_RATE_LIMIT_BURST_WINDOW_SECONDS=20
# Requests allowed per client per hour.
CLEO_RATE_LIMIT_HOURLY=60
# Simultaneous OpenAI streams one serverless instance will open.
CLEO_MAX_CONCURRENT_STREAMS=16
