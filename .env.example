# Cleo agent (OpenAI Responses API). Required for /cleo and /api/responses.
OPENAI_API_KEY=

# Optional. Public discovery identity for canonical links, feeds, and social
# metadata. Defaults to the alpha deploy, and previews stub it during prebuild;
# set it only when serving a custom domain.
# PUBLIC_SITE_URL=https://cleoalpha.vercel.app
# SITE_URL=https://cleoalpha.vercel.app

# --- Stage 2a accounts (Better Auth + Postgres) ----------------------------
# Neon Marketplace injects DATABASE_URL after `vercel install neon`. Locally,
# point at any Postgres 16 instance (see docs/handoff.md).
DATABASE_URL=

# Better Auth secret (Sensitive). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin Better Auth uses for callbacks / rpID. On Vercel this can be
# derived from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_BRANCH_URL; set explicitly
# for local dev:
# BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (second sign-in / recovery path). Callback URL:
#   {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
