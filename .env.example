# Cleo agent (OpenAI Responses API). Required for /cleo and /api/responses.
OPENAI_API_KEY=

# Optional. Public discovery identity for canonical links, feeds, and social
# metadata. Defaults to the alpha deploy, and previews stub it during prebuild;
# set it only when serving a custom domain.
# PUBLIC_SITE_URL=https://cleoalpha.vercel.app
# SITE_URL=https://cleoalpha.vercel.app

# Neon Postgres (Vercel Marketplace). Required for Better Auth.
# Prefer DATABASE_URL from `vercel integration add neon` + `vercel env pull`.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# Legacy Marketplace aliases also work:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Better Auth (self-hosted library — not a Marketplace product).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_SECRET=
# Production only — live public origin. Leave unset for Preview/Development;
# Preview trusts *.vercel.app via dynamic baseURL.allowedHosts.
# BETTER_AUTH_URL=https://cleoalpha.vercel.app

# Better Auth Infrastructure (dash.better-auth.com). Optional — enables the
# dashboard connection via the dash() plugin. Never put this in NEXT_PUBLIC_*.
# BETTER_AUTH_API_KEY=

# Sentinel / KV identify base (public ingestion URL — not a secret). Copy from
# dash.better-auth.com → your project → settings, shape:
# https://kv.better-auth.com/projects/{id}
# Client uses NEXT_PUBLIC_*; server dash()/sentinel() also read BETTER_AUTH_KV_URL.
# NEXT_PUBLIC_BETTER_AUTH_KV_URL=https://kv.better-auth.com/projects/YOUR_PROJECT_ID
# BETTER_AUTH_KV_URL=https://kv.better-auth.com/projects/YOUR_PROJECT_ID

# Sentry (cleo-studio / sentry-cleo). DSN is public by design; auth token is not.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@oxxxx.ingest.us.sentry.io/<project>
# SENTRY_DSN=https://<key>@oxxxx.ingest.us.sentry.io/<project>
# Optional environment label (defaults to NODE_ENV / VERCEL_ENV on server).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=<non-production-label>
# SENTRY_ENVIRONMENT=<non-production-label>
# US region API host for source map / release uploads (required for us.sentry.io orgs).
# SENTRY_URL=https://us.sentry.io
# Build-time secret for source map upload (Vercel / CI / Cursor Cloud). Create at
# https://cleo-studio.sentry.io/settings/auth-tokens/ with project:releases +
# org:read (or the "Release" / "Source Maps" scopes shown in the Next.js wizard).
# SENTRY_AUTH_TOKEN=
