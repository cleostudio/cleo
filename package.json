{
  "name": "cleo",
  "version": "3.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.22",
      "next>sharp": "0.35.3",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "prebuild": "node scripts/ensure-preview-env.mjs && node scripts/generate-og-runtime-fonts.mjs",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "build": "next build",
    "start": "next start",
    "test:security": "vitest run lib/security",
    "test:unit": "vitest run app components lib --exclude='**/*.live.test.ts'",
    "test:localization": "node --test scripts/localization.test.mjs",
    "verify:legacy-urls": "node scripts/verify-legacy-url-contract.mjs",
    "verify:links": "node scripts/verify-public-links.mjs",
    "verify:public-discovery": "node scripts/verify-public-discovery.mjs",
    "generate:atlas-content": "tsx scripts/atlas/generate-atlas-content.mjs",
    "write:atlas-about": "tsx scripts/atlas/write-atlas-about.mjs",
    "curate:atlas-photos": "node scripts/atlas/curate-commons-photos.mjs",
    "apply:atlas-handpicks": "node scripts/atlas/apply-gallery-handpicks.mjs",
    "import:atlas-photos": "node scripts/atlas/import-atlas-photos.mjs",
    "validate:atlas": "tsx scripts/atlas/preflight.mjs",
    "curate:space-photos": "node scripts/space/curate-space-photos.mjs",
    "import:space-photos": "node scripts/space/import-space-photos.mjs",
    "validate:space": "node scripts/space/preflight.mjs",
    "generate:cleo-topic-photo-zoom": "tsx scripts/cleo/generate-topic-photo-zoom.mjs",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec drizzle-kit migrate",
    "db:push": "pnpm exec drizzle-kit push",
    "db:studio": "pnpm exec drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@neondatabase/serverless": "^1.1.0",
    "@streamdown/code": "^1.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "beautiful-mermaid": "^1.1.3",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "0.1.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.3.0-preview.9",
    "next-mdx-remote": "^6.0.0",
    "openai": "^6.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shaders": "3.0.442",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "subset-font": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0-preview.9",
    "jsdom": "^29.1.1",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "vercel": "^58.4.0",
    "vitest": "^4.1.10"
  }
}
